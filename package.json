{
  "name": "workspace-tabs",
  "displayName": "Workspace Tabs",
  "description": "Color-coded tab bar for switching between VS Code workspaces",
  "version": "0.0.1",
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "workspaceTabs.addWorkspace",
        "title": "Add Workspace to Window",
        "category": "File"
      },
      {
        "command": "workspaceTabs.removeWorkspace",
        "title": "Remove Workspace from Window",
        "category": "File"
      },
      {
        "command": "workspaceTabs.show",
        "title": "Show Workspace Tabs",
        "category": "Workspace Tabs"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "workspaceTabs.addWorkspace" },
        { "command": "workspaceTabs.removeWorkspace" },
        { "command": "workspaceTabs.show" }
      ],
      "menuBar/file": [
        {
          "command": "workspaceTabs.addWorkspace",
          "group": "2_workspace@1"
        },
        {
          "command": "workspaceTabs.removeWorkspace",
          "group": "2_workspace@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "mocha --require ts-node/register 'src/test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "mocha": "^11.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^6.0.0"
  }
}
